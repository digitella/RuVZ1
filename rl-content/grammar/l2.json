{
  "lessonId": "l2",
  "items": [
    {
      "id": "g2a",
      "title": "Accusative for what you order",
      "summary": "Inanimate masculine nouns keep the nominative form in accusative. Feminine -a becomes -u. This is how you say 'I want X'.",
      "examples": [
        {
          "ru": "Я хочу кофе.",
          "en": "I want (some) coffee."
        },
        {
          "ru": "Я хочу булку.",
          "en": "I want a bun. (bulka -> bulku)"
        },
        {
          "ru": "Дайте чай, пожалуйста.",
          "en": "Give me tea, please."
        }
      ],
      "conjugation": {
        "infinitive": "хотеть",
        "tense": "present",
        "forms": [
          {
            "person": "ya",
            "ru": "хочу"
          },
          {
            "person": "ty",
            "ru": "хочешь"
          },
          {
            "person": "on/ona",
            "ru": "хочет"
          },
          {
            "person": "my",
            "ru": "хотим"
          },
          {
            "person": "vy",
            "ru": "хотите"
          },
          {
            "person": "oni",
            "ru": "хотят"
          }
        ]
      }
    },
    {
      "id": "g2b",
      "title": "Numbers 1-100 and ruble agreement",
      "summary": "After 2-4 use genitive singular (rublya), after 5+ use genitive plural (rubley). Learn 10, 20, 50, 100, 200.",
      "examples": [
        {
          "ru": "сто двадцать рублей",
          "en": "120 rubles"
        },
        {
          "ru": "двадцать пять рублей",
          "en": "25 rubles"
        }
      ],
      "conjugation": {
        "infinitive": null,
        "tense": null,
        "forms": [
          {
            "person": "1",
            "ru": "один"
          },
          {
            "person": "2",
            "ru": "два"
          },
          {
            "person": "5",
            "ru": "пять"
          },
          {
            "person": "10",
            "ru": "десять"
          },
          {
            "person": "20",
            "ru": "двадцать"
          },
          {
            "person": "50",
            "ru": "пятьдесят"
          },
          {
            "person": "100",
            "ru": "сто"
          }
        ]
      }
    }
  ]
