        { "id": "p302", "ru": "Прямо и направо", "en": "Straight and then right", "ipa": "[PRYA-ma i na-PRA-və]", "hint": "Final 'o' reduces to 'ə'.", "audio": "media/audio/p302.ogg" },
        { "id": "p303", "ru": "Минут пять пешком", "en": "About five minutes on foot", "ipa": "[mi-NUT pyat' pish-KOM]", "hint": "pyat ends with a soft sign - no audible 'b', just palatalization.", "audio": "media/audio/p303.ogg" },
