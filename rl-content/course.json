        { "id": "s302", "sentence_ru": "Потом ___.", "answer": "направо", "transcript": "Потом направо.", "en": "Then to the right.", "hint": "Direction adverb starting with na-.", "audio": "media/audio/s302.ogg" },
        { "id": "s303", "sentence_ru": "Я живу в России два ___ .", "answer": "года", "transcript": "Я живу в России два года.", "en": "I have lived in Russia for two years.", "hint": "Genitive singular after 'dva'.", "audio": "media/audio/s303.ogg" }
